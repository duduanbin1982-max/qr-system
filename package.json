{
  "name": "qr-system",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "devEngines": {
    "runtime": { "name": "node", "version": "24.22.0", "onFail": "error" },
    "packageManager": { "name": "npm", "version": "11.19.1", "onFail": "error" }
  },
  "scripts": {
    "preinstall": "node frontend/scripts/check-toolchain.mjs",
    "check:toolchain": "node frontend/scripts/check-toolchain.mjs",
    "test:toolchain": "node frontend/scripts/check-toolchain.mjs && node --test frontend/tests/toolchain/*.test.mjs",
    "dev": "node frontend/scripts/check-toolchain.mjs && vite",
    "check:api": "node frontend/scripts/check-toolchain.mjs && node frontend/scripts/check-api-facade.mjs",
    "check:imports": "node frontend/scripts/check-toolchain.mjs && node frontend/scripts/check-import-cycles.mjs",
    "check:layers": "node frontend/scripts/check-toolchain.mjs && node --test frontend/tests/architecture/frontend-layers.test.mjs && node frontend/scripts/check-frontend-layers.mjs",
    "check:architecture": "npm run test:toolchain && python -m pytest -q tests/test_architecture_imports.py && npm run check:api && npm run check:imports && npm run check:layers",
    "test:unit": "node frontend/scripts/check-toolchain.mjs && vitest run --config vitest.config.js",
    "test:unit:coverage": "node frontend/scripts/check-toolchain.mjs && vitest run --config vitest.config.js --coverage",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:frontend": "npm run test:unit && npm run test:e2e",
    "test:full": "node scripts/test-full.mjs",
    "verify:frontend": "npm run check:architecture && npm run test:unit && npm run test:e2e && npm run build",
    "build": "node frontend/scripts/check-toolchain.mjs && npm run check:api && npm run check:imports && npm run check:layers && vite build",
    "preview": "node frontend/scripts/check-toolchain.mjs && vite preview"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "29.1.1",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue": "^3.5.38"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1"
  },
  "overrides": {
    "brace-expansion": "2.1.3"
  }
}
