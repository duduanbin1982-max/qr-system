{
  "name": "qr-system",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <21"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "vite",
    "check:api": "node frontend/scripts/check-api-facade.mjs",
    "check:imports": "node frontend/scripts/check-import-cycles.mjs",
    "check:architecture": "npm run check:api && npm run check:imports",
    "test:unit": "vitest run --config vitest.config.js",
    "test:unit:coverage": "vitest run --config vitest.config.js --coverage",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:frontend": "npm run test:unit && npm run test:e2e",
    "build": "npm run check:api && npm run check:imports && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "29.1.1",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue": "^3.5.38"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1"
  },
  "overrides": {
    "brace-expansion": "2.1.3"
  }
}
